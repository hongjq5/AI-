# Copy to .env and replace every CHANGE_ME value with your own random password.
# Do not commit the .env file. These are placeholders, not usable credentials.
# Use independently generated random passwords of at least 32 letters/digits;
# this local launcher expects unquoted values without whitespace or shell symbols.
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root_random_password
MYSQL_DATABASE=yubi
MYSQL_USER=bi_app
MYSQL_PASSWORD=CHANGE_ME_mysql_app_random_password
REDIS_PASSWORD=CHANGE_ME_redis_random_password
RABBITMQ_DEFAULT_USER=bi_app
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbitmq_random_password
RABBITMQ_DEFAULT_VHOST=yubi
